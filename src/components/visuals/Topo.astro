---
// A wall from the guide: the real photo with the lines drawn on, and a few of its problems.
import { Image } from 'astro:assets';
import karma from '../../assets/zalog-karma.jpg';
import { zalogTopo as t } from '../../data/content';

// Same grade colours as the guide itself.
const band = (g: string) => (g < '7a' ? '#2f9a54' : g < '7c' ? '#2f74c4' : g <= '8a' ? '#e5850f' : '#c0244c');
// White on green and orange is too faint, as in the guide.
const ink = (g: string) => (['#2f9a54', '#e5850f'].includes(band(g)) ? '#1d211e' : '#fff');
---

<div class="art">
  <Image
    src={karma}
    alt={t.alt}
    width={800}
    widths={[480, 800]}
    sizes="(max-width: 720px) 100vw, (max-width: 1100px) 50vw, 400px"
    quality={50}
    loading="lazy"
  />
  <p class="tag">✓ works offline</p>
  <div class="panel">
    <p class="wall">{t.wall}</p>
    <ol>
      {
        t.problems.map((p) => (
          <li>
            <span class="num" style={`background:${band(p.grade)};color:${ink(p.grade)}`}>{p.num}</span>
            <span class="name">{p.name}</span>
            <span class="grade" style={`background:${band(p.grade)};color:${ink(p.grade)}`}>{p.grade}</span>
          </li>
        ))
      }
    </ol>
  </div>
</div>

<style>
  .art {
    position: relative;
    height: 100%;
    min-height: 300px;
  }
  img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 45%;
  }
  .tag {
    position: absolute;
    left: 16px;
    top: 16px;
    margin: 0;
    padding: 4px 12px;
    border: 1px solid var(--line-strong);
    border-radius: 99px;
    background: rgb(10 10 10 / 0.85);
    color: var(--ok);
    font: 12px var(--mono);
  }
  .panel {
    position: absolute;
    right: 16px;
    bottom: 16px;
    width: min(250px, calc(100% - 32px));
    padding: 12px 14px;
    border: 1px solid var(--line-strong);
    border-radius: 10px;
    background: rgb(10 10 10 / 0.88);
    font-size: 13px;
  }
  .wall {
    margin: 0 0 8px;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }
  ol {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 10px;
  }
  .num {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border: 1.5px solid #fff;
    border-radius: 50%;
    font-size: 11px;
    font-weight: 600;
  }
  .grade {
    min-width: 38px;
    padding: 1px 6px;
    border-radius: 3px;
    font-size: 12px;
    font-weight: 600;
    text-align: center;
  }
</style>
